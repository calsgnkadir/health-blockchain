# VIP Health Vault — Environment Variables Configuration Template
# Copy this file to '.env' and populate values for your deployment.

ENVIRONMENT=development

# Interface the standalone runner binds to. Defaults to loopback; set this only
# when the vault sits behind a trusted reverse proxy inside the private subnet.
# VHV_BIND_HOST=0.0.0.0
VHV_DEMO_MODE=true

# Database Configuration (Optional: Defaults to local SQLite)
# VHV_DATABASE_URL=postgresql://user:password@localhost:5432/vault_db

# ── Signing / At-Rest Encryption Key ────────────────────────────────────────
# One key signs every block AND derives the AES-256-GCM at-rest key, so LOSING
# IT MAKES EVERY ENCRYPTED RECORD PERMANENTLY UNREADABLE. In production, set it
# here (or provision the OS keyring) and back it up — see docs/KEY_MANAGEMENT.md.
# HEALTH_BLOCKCHAIN_KEY=paste-a-long-random-base64-value
#
# First-run installs with no data yet may let the vault mint a key automatically.
# Production refuses to auto-generate one otherwise, to avoid orphaning existing data.
# VHV_ALLOW_GENERATED_KEY=false

# WebAuthn / Passkey verification. Defaults accept loopback origins; set these
# when the vault is reached over a hostname.
# VHV_WEBAUTHN_RP_ID=vault.internal
# VHV_WEBAUTHN_ORIGINS=https://vault.internal

# Laboratory (LIS) Gateway — shared secret for POST /api/v1/webhooks/lis.
# The gateway writes blocks to patient chains, so it stays disabled (503) until
# this is set. Send it as the X-LIS-Api-Key header.
# VHV_LIS_API_KEY=change-me-to-a-long-random-value

# Encrypted file attachments. With no IPFS daemon configured, attachments are
# stored (still AES-encrypted) in a local content-addressed folder — no external
# network call is made. Point this at a private IPFS node only if you run one.
# VHV_IPFS_API_URL=http://localhost:5001
